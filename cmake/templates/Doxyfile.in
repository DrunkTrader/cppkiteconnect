PROJECT_NAME           = "CPPKiteConnect"
OUTPUT_DIRECTORY       = "@CMAKE_CURRENT_BINARY_DIR@/docs/"
INPUT                  = "@CMAKE_CURRENT_SOURCE_DIR@/include/kitepp" "@CMAKE_CURRENT_SOURCE_DIR@/include/kitepp.hpp" "@CMAKE_CURRENT_SOURCE_DIR@/docs/mainpage.md" "@CMAKE_CURRENT_SOURCE_DIR@/docs/building.md" "@CMAKE_CURRENT_SOURCE_DIR@/docs/dependencies.md" "@CMAKE_CURRENT_SOURCE_DIR@/docs/runtime_contract.md" "@CMAKE_CURRENT_SOURCE_DIR@/docs/release-notes.md"
RECURSIVE              = YES
EXAMPLE_PATH           = "@CMAKE_CURRENT_SOURCE_DIR@/examples"
GENERATE_HTML          = YES
USE_MDFILE_AS_MAINPAGE = "@CMAKE_CURRENT_SOURCE_DIR@/docs/mainpage.md"
EXCLUDE_SYMBOLS = "internal"
ENABLE_PREPROCESSING = YES
MACRO_EXPANSION = YES
HAVE_DOT = YES
DOT_NUM_THREADS = 2
WARN_IF_UNDOCUMENTED = NO

GENERATE_TREEVIEW      = YES
DISABLE_INDEX = NO
FULL_SIDEBAR = NO
HTML_EXTRA_STYLESHEET  = "@CMAKE_CURRENT_SOURCE_DIR@/docs/doxygen-awesome-css/doxygen-awesome.css"
HTML_EXTRA_FILES = "@CMAKE_CURRENT_SOURCE_DIR@/docs/doxygen-awesome-css/doxygen-awesome-darkmode-toggle.js"
HTML_HEADER = "@CMAKE_CURRENT_SOURCE_DIR@/docs/header.html"
