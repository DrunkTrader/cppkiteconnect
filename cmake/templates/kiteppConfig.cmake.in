@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(OpenSSL 3.0)
include("${CMAKE_CURRENT_LIST_DIR}/kiteppCoreTargets.cmake")
set(kitepp_models_FOUND TRUE)
set(kitepp_rest_FOUND TRUE)
set(kitepp_ticker_FOUND FALSE)
set(kitepp_kitepp_FOUND FALSE)
if(NOT kitepp_FIND_COMPONENTS)
    set(kitepp_FIND_COMPONENTS kitepp)
    set(kitepp_FIND_REQUIRED_kitepp TRUE)
endif()
set(_kitepp_wants_ticker FALSE)
set(_kitepp_requires_ticker FALSE)
foreach(component IN LISTS kitepp_FIND_COMPONENTS)
    if(component STREQUAL "ticker" OR component STREQUAL "kitepp")
        set(_kitepp_wants_ticker TRUE)
        if(kitepp_FIND_REQUIRED_${component})
            set(_kitepp_requires_ticker TRUE)
        endif()
    elseif(NOT component STREQUAL "rest" AND NOT component STREQUAL "models")
        set(kitepp_${component}_FOUND FALSE)
        set(kitepp_NOT_FOUND_MESSAGE "Unknown kitepp component: ${component}")
    endif()
endforeach()
if(_kitepp_wants_ticker)
    if(@KITEPP_ENABLE_TICKER@)
        if(_kitepp_requires_ticker)
            find_dependency(Boost 1.83 CONFIG)
        else()
            # An unavailable optional streaming dependency must not reject core.
            find_package(Boost 1.83 CONFIG QUIET)
        endif()
        if(Boost_FOUND AND TARGET Boost::headers)
            include("${CMAKE_CURRENT_LIST_DIR}/kiteppTickerTargets.cmake")
            set(kitepp_ticker_FOUND TRUE)
            set(kitepp_kitepp_FOUND TRUE)
        endif()
    else()
        set(kitepp_NOT_FOUND_MESSAGE "This package was built with KITEPP_ENABLE_TICKER=OFF")
    endif()
endif()
check_required_components(kitepp)
unset(_kitepp_wants_ticker)
unset(_kitepp_requires_ticker)
